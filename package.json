{
  "name": "pulse-messenger",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w messenger-server",
    "dev:client": "npm run dev -w messenger-client",
    "build": "npm run build -w messenger-client",
    "start": "npm run start -w messenger-server",
    "test": "node scripts/smoke-test.mjs",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
